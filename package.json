{
  "name": "tree-sitter-hurl",
  "version": "1.6.2",
  "description": "",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "test:corpus": "node test/run-corpus.cjs",
    "test": "npm run test:corpus && node --test bindings/node/*_test.js"
  },
  "author": "Jacob Pfeifer",
  "license": "Apache-2.0",
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "0.27.1",
    "tree-sitter": "^0.25.1",
    "prebuildify": "^6.0.0"
  },
  "tree-sitter": [
    {
      "scope": "source.hurl",
      "file-types": [
        "hurl"
      ]
    }
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-cli@0.27.1": true
  }
}
